{
  "name": "@glastor-core/vortex",
  "version": "1.1.0",
  "license": "MIT",
  "exports": "./src/main.ts",
  "tasks": {
    "setup": "git config core.hooksPath .githooks",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:pre-commit": "deno run --allow-run=deno scripts/pre-commit.ts",
    "hooks:pre-push": "deno run --allow-run=deno scripts/pre-push.ts",
    "start": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run=git src/main.ts",
    "analyze": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run=git src/main.ts --dry-run",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run=git",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/main.ts scripts/verify-commit.ts scripts/pre-commit.ts scripts/pre-push.ts tests/vortex.test.ts tests/scheduler.test.ts",
    "compile": "deno compile --allow-read --allow-write --allow-env --allow-run=git --output dist/vortex src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": ["src/", "scripts/", "tests/", "README.md", "CHANGELOG.md", "CONTRIBUTORS.md", ".github/"]
  },
  "lint": {
    "include": ["src/", "scripts/", "tests/"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
